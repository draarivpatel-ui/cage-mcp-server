  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "sentinel-lint": "0.2.0",
    "pathcage": "1.0.1",
    "headersafe": "1.0.1",
    "redirectcage": "1.0.0",
    "envcage": "1.0.0",
